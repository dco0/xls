
---

CompileFlags:
    Add: [
        -std=c++23, -Wall, -Werror, -Wpedantic, -Wextra,
        # linting disabling
        -Wno-unused-variable, -Wno-unused-function, -Wno-undefined-internal,
        # extension enabling
        -Wno-c99-extensions, -Wno-gnu-empty-struct, -Wno-flexible-array-extensions, -Wno-vla-cxx-extension, -Wno-zero-length-array
    ]

Diagnostics:
    UnusedIncludes: Strict
    MissingIncludes: Strict
